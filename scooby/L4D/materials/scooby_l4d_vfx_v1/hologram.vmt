"VertexLitGeneric"
{
 "$basetexture" "scooby_l4d_vfx_v1/hologram"
 "$model" "1"
 "$nocull" "1"
 "$selfillum" "1"
 "$additive" "1"
 "$translucent" "1"
 "Proxies"
 {
  "TextureScroll"
  {
   "texturescrollvar" "$basetexturetransform"
   "texturescrollrate" "0.03"
   "texturescrollangle" "90"
  }
 }
}
