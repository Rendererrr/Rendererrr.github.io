    "Secure Boot is enabled. Disable it in your UEFI firmware to continue.":  "Secure Boot \u304c\u6709\u52b9\u3067\u3059\u3002\u7d9a\u884c\u3059\u308b\u306b\u306f UEFI \u30d5\u30a1\u30fc\u30e0\u30a6\u30a7\u30a2\u3067\u7121\u52b9\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
    "The downloaded module is empty or corrupted \u2014 try again.":  "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3055\u308c\u305f\u30e2\u30b8\u30e5\u30fc\u30eb\u304c\u7a7a\u307e\u305f\u306f\u7834\u640d\u3057\u3066\u3044\u307e\u3059 \u2014 \u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002",
    "The driver refused the Anti-VM change. (code 0x%08x)":  "\u30c9\u30e9\u30a4\u30d0\u30fc\u304c Anti-VM \u306e\u5909\u66f4\u3092\u62d2\u5426\u3057\u307e\u3057\u305f\u3002(\u30b3\u30fc\u30c9 0x%08x)",
    "The driver refused the PatchGuard request. (code 0x%08x)":  "\u30c9\u30e9\u30a4\u30d0\u30fc\u304c PatchGuard \u306e\u8981\u6c42\u3092\u62d2\u5426\u3057\u307e\u3057\u305f\u3002(\u30b3\u30fc\u30c9 0x%08x)",
    "Unknown subscription tier":  "\u4e0d\u660e\u306a\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u968e\u5c64",
    "Your subscription doesn't include Anti-VM.":  "\u3054\u5229\u7528\u306e\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u306b\u306f Anti-VM \u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002",
    "Your subscription doesn't include injection.":  "\u3054\u5229\u7528\u306e\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u306b\u306f\u30a4\u30f3\u30b8\u30a7\u30af\u30b7\u30e7\u30f3\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002",
    "Your subscription doesn't include the driver log view.":  "\u3054\u5229\u7528\u306e\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u306b\u306f\u30c9\u30e9\u30a4\u30d0\u30fc\u30ed\u30b0\u306e\u8868\u793a\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002",
    "Your subscription doesn't include the driver status check.":  "\u3054\u5229\u7528\u306e\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u306b\u306f\u30c9\u30e9\u30a4\u30d0\u30fc\u306e\u72b6\u614b\u78ba\u8a8d\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002",
    "Your subscription doesn't include the PatchGuard bypass.":  "\u3054\u5229\u7528\u306e\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u306b\u306f PatchGuard \u30d0\u30a4\u30d1\u30b9\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
}