    "Nenyoo is active.":  "Nenyoo \u0430\u043a\u0442\u0438\u0432\u0435\u043d.",
    "No backup found. The original Windows bootloader cannot be restored automatically.":  "\u0420\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430. \u041e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u0447\u0438\u043a Windows \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.",
    "No DLL selected \u2014 pick one and try again.":  "DLL \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u0430 \u2014 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.",
    "No response from server":  "\u041d\u0435\u0442 \u043e\u0442\u0432\u0435\u0442\u0430 \u043e\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u0430",
    "Not signed in. Please log in and try again.":  "\u0412\u044b \u043d\u0435 \u0432\u043e\u0448\u043b\u0438. \u0412\u043e\u0439\u0434\u0438\u0442\u0435 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443.",
    "Premium access with advanced protection, exclusive options, custom scripts, public lobbies, and lifetime updates.":  "\u041f\u0440\u0435\u043c\u0438\u0443\u043c-\u0434\u043e\u0441\u0442\u0443\u043f \u0441 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u043e\u0439, \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u044b\u043c\u0438 \u043e\u043f\u0446\u0438\u044f\u043c\u0438, \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u043c\u0438 \u0441\u043a\u0440\u0438\u043f\u0442\u0430\u043c\u0438, \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u043b\u043e\u0431\u0431\u0438 \u0438 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u043c\u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438.",
    "Same as Legacy gameplay tools with VFX, session management, business options, crashes, kicks, and recovery.":  "Same as Legacy gameplay tools with VFX, session management, business options, crashes, kicks, and recovery.",
    "Secure Boot is enabled. Disable it in your UEFI firmware to continue.":  "Secure Boot \u0432\u043a\u043b\u044e\u0447\u0451\u043d. \u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u0432 \u043f\u0440\u043e\u0448\u0438\u0432\u043a\u0435 UEFI, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c.",
    "Stay Tuned.":  "\u0421\u043a\u043e\u0440\u043e.",
    "Tester":  "\u0422\u0435\u0441\u0442\u0435\u0440",
    "The downloaded module is empty or corrupted \u2014 try again.":  "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439 \u043c\u043e\u0434\u0443\u043b\u044c \u043f\u0443\u0441\u0442 \u0438\u043b\u0438 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0451\u043d \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.",
    "The driver refused the Anti-VM change. (code 0x%08x)":  "\u0414\u0440\u0430\u0439\u0432\u0435\u0440 \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 Anti-VM. (\u043a\u043e\u0434 0x%08x)",
    "The driver refused the PatchGuard request. (code 0x%08x)":  "\u0414\u0440\u0430\u0439\u0432\u0435\u0440 \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b \u0437\u0430\u043f\u0440\u043e\u0441 PatchGuard. (\u043a\u043e\u0434 0x%08x)",
    "Unknown subscription tier":  "\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438",
    "Your subscription doesn't include Anti-VM.":  "\u0412\u0430\u0448\u0430 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 Anti-VM.",
