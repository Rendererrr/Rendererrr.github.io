    "Couldn't reach the driver to disable PatchGuard. Try again in a moment.":  "PatchGuard \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0924\u0915 \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0901\u091a \u0938\u0915\u093e\u0964 \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u092e\u0947\u0902 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",
    "Disabling PatchGuard needs the driver, but it's not responding.":  "PatchGuard \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948\u0964",
    "Failed to parse init response":  "\u0907\u0928\u093f\u091f \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u093e\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940",
    "Failed to parse login response":  "\u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u093e\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940",
    "Failed to parse register response":  "\u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u093e\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940",
    "Frame Generation disabled":  "Frame Generation \u0905\u0915\u094d\u0937\u092e",
    "GTA V is not running":  "GTA V \u0928\u0939\u0940\u0902 \u091a\u0932 \u0930\u0939\u093e",
    "Injection needs the driver, but it's not responding.":  "\u0907\u0902\u091c\u0947\u0915\u094d\u0936\u0928 \u0915\u094b \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948\u0964",
    "Installing menu...":  "\u092e\u0947\u0928\u0942 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...",
    "Load":  "\u0932\u094b\u0921 \u0915\u0930\u0947\u0902",
    "Load failed":  "\u0932\u094b\u0921 \u0935\u093f\u092b\u0932",
    "Loaded":  "\u0932\u094b\u0921 \u0939\u0941\u0906",
    "Menu install":  "\u092e\u0947\u0928\u0942 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",
    "Menu install failed":  "\u092e\u0947\u0928\u0942 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0935\u093f\u092b\u0932",
    "Menu installed":  "\u092e\u0947\u0928\u0942 \u0938\u094d\u0925\u093e\u092a\u093f\u0924",
    "Nenyoo is active.":  "Nenyoo \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964",
    "No backup found. The original Windows bootloader cannot be restored automatically.":  "\u0915\u094b\u0908 \u092c\u0948\u0915\u0905\u092a \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u092e\u0942\u0932 Windows \u092c\u0942\u091f\u0932\u094b\u0921\u0930 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964",
    "No DLL selected \u2014 pick one and try again.":  "\u0915\u094b\u0908 DLL \u091a\u092f\u0928\u093f\u0924 \u0928\u0939\u0940\u0902 \u2014 \u090f\u0915 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",
    "No response from server":  "\u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u0915\u094b\u0908 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902",
    "Not signed in. Please log in and try again.":  "\u0938\u093e\u0907\u0928 \u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",
    "Secure Boot is enabled. Disable it in your UEFI firmware to continue.":  "Secure Boot \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0964 \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 UEFI \u092b\u093c\u0930\u094d\u092e\u0935\u0947\u092f\u0930 \u092e\u0947\u0902 \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964",
    "The downloaded module is empty or corrupted \u2014 try again.":  "\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0916\u093e\u0932\u0940 \u092f\u093e \u0926\u0942\u0937\u093f\u0924 \u0939\u0948 \u2014 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",
    "The driver refused the Anti-VM change. (code 0x%08x)":  "\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0947 Anti-VM \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 (\u0915\u094b\u0921 0x%08x)",
    "The driver refused the PatchGuard request. (code 0x%08x)":  "\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0947 PatchGuard \u0905\u0928\u0941\u0930\u094b\u0927 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 (\u0915\u094b\u0921 0x%08x)",
    "Unknown subscription tier":  "\u0905\u091c\u094d\u091e\u093e\u0924 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0938\u094d\u0924\u0930",
    "Your subscription doesn't include Anti-VM.":  "\u0906\u092a\u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u092e\u0947\u0902 Anti-VM \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "Your subscription doesn't include injection.":  "\u0906\u092a\u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u092e\u0947\u0902 \u0907\u0902\u091c\u0947\u0915\u094d\u0936\u0928 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "Your subscription doesn't include the driver log view.":  "\u0906\u092a\u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0932\u0949\u0917 \u0926\u0943\u0936\u094d\u092f \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "Your subscription doesn't include the driver status check.":  "\u0906\u092a\u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0901\u091a \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "Your subscription doesn't include the PatchGuard bypass.":  "\u0906\u092a\u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u092e\u0947\u0902 PatchGuard \u092c\u093e\u092f\u092a\u093e\u0938 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
}